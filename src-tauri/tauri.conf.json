{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent of Empires",
  "mainBinaryName": "agent-of-empires",
  "version": "0.1.0",
  "identifier": "dev.fontenele.agent-of-empires",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent of Empires",
        "width": 1320,
        "height": 780,
        "minWidth": 760,
        "minHeight": 440,
        "backgroundColor": "#14110c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
